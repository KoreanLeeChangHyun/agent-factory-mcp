AGENT_FACTORY_ENVIRONMENT=local
AGENT_FACTORY_DEBUG=false
AGENT_FACTORY_LOG_LEVEL=INFO
AGENT_FACTORY_DATABASE_URL=postgresql+asyncpg://agent_factory:agent_factory@postgres:5432/agent_factory
AGENT_FACTORY_REDIS_URL=redis://redis:6379/0
AGENT_FACTORY_CELERY_BROKER_URL=redis://redis:6379/1
AGENT_FACTORY_CELERY_RESULT_BACKEND=redis://redis:6379/2
AGENT_FACTORY_S3_ENDPOINT_URL=http://minio:9000
AGENT_FACTORY_S3_ACCESS_KEY=agent_factory
AGENT_FACTORY_S3_SECRET_KEY=change-me-in-local-env
AGENT_FACTORY_S3_BUCKET=agent-factory
AGENT_FACTORY_AUTH_TOKEN_SECRET=replace-with-at-least-32-random-bytes
AGENT_FACTORY_SESSION_COOKIE_SECURE=false
# AGENT_FACTORY_GOOGLE_CLIENT_ID=
# AGENT_FACTORY_GOOGLE_CLIENT_SECRET=
# AGENT_FACTORY_GITHUB_CLIENT_ID=
# AGENT_FACTORY_GITHUB_CLIENT_SECRET=
AGENT_FACTORY_PUBLIC_BASE_URL=http://127.0.0.1:8000
AGENT_FACTORY_SMTP_HOST=mailpit
AGENT_FACTORY_SMTP_PORT=1025
AGENT_FACTORY_SMTP_FROM_ADDRESS=no-reply@agent-factory.local

POSTGRES_DB=agent_factory
POSTGRES_USER=agent_factory
POSTGRES_PASSWORD=agent_factory
MINIO_ROOT_USER=agent_factory
MINIO_ROOT_PASSWORD=change-me-in-local-env
