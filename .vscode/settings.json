{
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/node_modules": true,
    "**/.venv": true,
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/*.pyo": true,
    "**/*.egg-info": true,
    "**/.cache": true,
    "**/.pytest_cache": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true,
    "**/.vite": true,
    "**/.coverage": true,
    "**/.coverage.*": true,
    "**/coverage": true,
    "**/htmlcov": true,
    "**/dist": true,
    "**/dist-types": true,
    "**/build": true,
    "**/*.tsbuildinfo": true,
    "**/.backup": true,
    "**/playwright-report": true,
    "**/test-results": true,
    "pnpm-lock.yaml": true,
    "uv.lock": true
  },
  "eslint.options": {
    "overrideConfigFile": "./scripts/quality/eslint.config.mjs"
  },
  "prettier.ignorePath": "scripts/quality/prettier.ignore"
}
