AGENT_FACTORY_ENVIRONMENT=production
AGENT_FACTORY_DEBUG=false
AGENT_FACTORY_LOG_LEVEL=INFO
AGENT_FACTORY_DATABASE_URL=postgresql+asyncpg://agent_factory_app:SECRET@postgres:5432/agent_factory
AGENT_FACTORY_REDIS_URL=redis://redis:6379/0
AGENT_FACTORY_CELERY_BROKER_URL=redis://redis:6379/1
AGENT_FACTORY_CELERY_RESULT_BACKEND=redis://redis:6379/2
AGENT_FACTORY_S3_ENDPOINT_URL=https://objects.example.com
AGENT_FACTORY_S3_ACCESS_KEY=SECRET_MANAGER_REFERENCE
AGENT_FACTORY_S3_SECRET_KEY=SECRET_MANAGER_REFERENCE
AGENT_FACTORY_S3_BUCKET=agent-factory-production
AGENT_FACTORY_AUTH_TOKEN_SECRET=SECRET_MANAGER_REFERENCE_MINIMUM_32_BYTES
AGENT_FACTORY_INTEGRATION_ENCRYPTION_KEY=INDEPENDENT_SECRET_MANAGER_REFERENCE
AGENT_FACTORY_SESSION_COOKIE_SECURE=true
AGENT_FACTORY_PUBLIC_BASE_URL=https://agent-factory.example.com
AGENT_FACTORY_TRUSTED_HOSTS=["agent-factory.example.com"]
AGENT_FACTORY_CORS_ALLOWED_ORIGINS=["https://agent-factory.example.com"]
AGENT_FACTORY_EMBEDDING_PROVIDER=openai-compatible
AGENT_FACTORY_EMBEDDING_API_KEY=SECRET_MANAGER_REFERENCE
AGENT_FACTORY_SMTP_HOST=smtp.example.com
AGENT_FACTORY_SMTP_PORT=587
AGENT_FACTORY_SMTP_USE_TLS=true
AGENT_FACTORY_SMTP_FROM_ADDRESS=no-reply@example.com
AGENT_FACTORY_DOMAIN=agent-factory.example.com
