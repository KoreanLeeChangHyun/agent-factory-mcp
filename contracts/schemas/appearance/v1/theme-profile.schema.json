{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "theme-profile.schema.json",
  "title": "Theme profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "userId", "revision", "base", "density", "overrides", "reducedMotion"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "userId": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "revision": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "base": {"enum": ["dark", "light", "high-contrast"]},
    "density": {"enum": ["compact", "comfortable"]},
    "overrides": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "accent": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
        "focus": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
        "surface": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
        "text": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}
      }
    },
    "reducedMotion": {"type": "boolean"}
  }
}
