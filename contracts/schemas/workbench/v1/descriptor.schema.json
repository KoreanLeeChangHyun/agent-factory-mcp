{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "descriptor.schema.json",
  "title": "Workbench descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "title", "icon", "regions"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "version": {"const": 1},
    "title": {"type": "string", "minLength": 1, "maxLength": 80},
    "description": {"type": "string", "maxLength": 500},
    "icon": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}@1$"},
    "regions": {"type": "array", "items": {"enum": ["task-list", "sidebar", "panel"]}, "minItems": 3, "maxItems": 3, "uniqueItems": true}
  }
}
