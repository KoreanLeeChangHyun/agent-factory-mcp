{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "view-state.schema.json",
  "title": "Workbench view state v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "selectedWorkbench", "sidebarOpen", "sidebarWidth", "selection", "expanded"],
  "properties": {
    "version": {"const": 1},
    "selectedWorkbench": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "sidebarOpen": {"type": "boolean"},
    "sidebarWidth": {"type": "integer", "minimum": 180, "maximum": 520},
    "selection": {"type": ["string", "null"], "maxLength": 128},
    "expanded": {"type": "array", "maxItems": 100, "items": {"type": "string", "maxLength": 128}, "uniqueItems": true}
  }
}
