{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "release.schema.json",
  "title": "Workbench release v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["releaseId", "definitionId", "revision", "schemaDigest", "definition"],
  "properties": {
    "releaseId": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "definitionId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "revision": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "schemaDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "definition": {"$ref": "definition.schema.json"}
  }
}
