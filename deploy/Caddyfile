{$AGENT_FACTORY_DOMAIN} {
  encode zstd gzip
  redir /factory /factory/ 308
  handle /factory/* {
    reverse_proxy api:8000 {
      health_uri /ready
      health_interval 10s
    }
    request_body { max_size 30MB }
  }
  handle { respond "Not Found" 404 }
  @oauth_callback path /factory/api/integrations/oauth/*/callback
  log_skip @oauth_callback
  log { output stdout; format json }
}
