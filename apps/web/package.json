  },
  "devDependencies": {
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.2",
    "vite": "7.1.3",
    "typescript": "5.9.2",
    "vitest": "3.2.4",
    "eslint": "9.35.0",
    "@eslint/js": "9.35.0",
    "typescript-eslint": "8.42.0"
